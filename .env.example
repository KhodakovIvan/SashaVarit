BOT_TOKEN=
CHANNEL_ID=

# Если cloudflared не установлен, укажите публичный HTTPS сами (ngrok и т.п.)
WEBAPP_URL=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080

SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_EMAIL_TO=mail@edatomsk.ru

# Копия исходящих в «Отправленные». Если IMAP_PASSWORD пустой — берётся SMTP_PASSWORD и наоборот
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Адрес офиса в письме на кухню. Телефон админа бот спрашивает командой /myphone
DELIVERY_ADDRESS=
DELIVERY_COMMENT=

DEADLINE_HOUR=9
DEADLINE_MINUTE=15
DEADLINE_ENABLED=0
POST_HOUR=8
POST_MINUTE=0
TIMEZONE=Asia/Tomsk

# Локальный прокси v2rayN / Hiddify, если api.telegram.org недоступен
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
